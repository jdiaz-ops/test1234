# Base de datos
DATABASE_URL="postgresql://usuario:password@localhost:5432/marcolini_dev?schema=public"

# URL pública donde vive la app — se usa para armar links en correos
# (verificación, recuperación de contraseña) y las URLs de webhook que se le
# muestran a las marcas. En local no hace falta (usa localhost:3000 por
# defecto); en producción ponla con tu dominio real, sin "/" al final.
APP_URL="https://tu-dominio.com"

# Auth.js
AUTH_SECRET="genera-un-valor-aleatorio-largo-aqui"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email transaccional (recuperación de contraseña, verificación, notificaciones)
RESEND_API_KEY=""

# Dirección desde la que salen los correos. Mientras no tengas un dominio
# propio verificado en Resend, déjala vacía — cae a la dirección de prueba
# de Resend (onboarding@resend.dev), que funciona sin configurar nada pero
# solo entrega a la cuenta de correo con la que te registraste en Resend.
# Apenas verifiques tu dominio en Resend (Domains → Add Domain), ponla aquí,
# ej: EMAIL_FROM="Marcolini <no-reply@tu-dominio.com>"
EMAIL_FROM=""

# ePayco (Pagos Divididos) — sin estas dos, el Motor de Pagos cae a modo
# simulado (igual que el correo sin RESEND_API_KEY): registra en consola
# cada cobro/pago que "haría" en vez de llamar a ePayco de verdad.
EPAYCO_PUBLIC_KEY=""
EPAYCO_PRIVATE_KEY=""

# Secreto que debe mandar el cron diario externo (ej. Vercel Cron) al
# llamar /api/cron/pagos-diarios — sin esto, esa ruta rechaza todo.
CRON_SECRET=""

# Shopify / WooCommerce — credenciales por marca, se guardan en la base de
# datos (BrandProfile), no aquí. Estas variables son solo para la app propia
# si en el futuro se registra como Shopify App.
SHOPIFY_APP_API_KEY=""
SHOPIFY_APP_API_SECRET=""

# Solo para "npx prisma db seed" — nunca se leen en tiempo de ejecución de
# la app. En producción, ponle tu correo y una contraseña real ANTES de
# sembrar por primera vez (si los dejas vacíos, cae al usuario de pruebas
# admin@marcolini.co / marcolini-admin-2026 — nunca uses eso en producción).
# SEED_DEMO_DATA=true solo se usa en desarrollo, para tener 2 marcas de
# ejemplo con las que probar — jamás lo actives en la base real.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
SEED_DEMO_DATA="false"
