// ============================================================================
// MARCOLINI — esquema de base de datos
//
// Este archivo es la traducción directa, entidad por entidad, de todas las
// reglas de negocio definidas durante el diseño de la plataforma: portales de
// Creador y Marca, Panel Admin, motores de Atribución / Comisiones / Pagos,
// Retos y Campañas, y Mensajería.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// AUTENTICACIÓN (compatible con Auth.js / NextAuth — login compartido que
// enruta automáticamente al portal correcto según el rol de la cuenta)
// ----------------------------------------------------------------------------

enum UserRole {
  CREATOR
  BRAND
  ADMIN
}

/// Roles internos del Panel Admin — permisos limitados por rol (Fase 2, pero
/// el modelo ya queda listo desde ahora para no rediseñar después).
enum AdminRole {
  OWNER // Propietario: acceso total
  SUPPORT // Ve y resuelve disputas/reclamos
  FINANCE // Ve panel de finanzas, cobros, pagos, reportes
  BRAND_APPROVER // Revisa y aprueba/rechaza marcas nuevas
  CREATOR_APPROVER // Gestiona creadores (suspender/reactivar cuentas)
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String? // null si el usuario solo usa login con Google
  image         String?
  role          UserRole

  // Solo aplica si role = ADMIN
  adminRole        AdminRole?
  twoFactorEnabled Boolean    @default(false)
  twoFactorSecret  String?

  creatorProfile CreatorProfile?
  brandProfile   BrandProfile?

  notifications Notification[]
  deviceTokens  DeviceToken[]

  accounts Account[]
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Modelos requeridos por el adaptador de Prisma de Auth.js (login con Google,
// y en el futuro Instagram, para creadores).
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Usado tanto para verificación de email como para recuperación de contraseña.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Token de un solo uso, de muy corta duración, para que un admin Propietario
/// pueda "entrar como" una marca o un creador y ver el portal tal cual lo ve
/// esa cuenta (soporte, pruebas) — nunca se reutiliza el mecanismo de
/// VerificationToken para esto, porque ese sí se manda por correo y no debe
/// poder usarse para iniciar sesión sin contraseña.
model ImpersonationToken {
  id              String   @id @default(cuid())
  token           String   @unique
  targetUserId    String
  createdByUserId String
  expires         DateTime
  createdAt       DateTime @default(now())
}

// ----------------------------------------------------------------------------
// VERTICALES Y CATEGORÍAS
// Estructurado en dos niveles desde el día 1 para soportar la expansión
// planeada (Uñas -> Belleza y cuidado personal -> Moda y ropa) sin tener que
// rediseñar nada — hoy solo existirá el vertical "Uñas" poblado.
// ----------------------------------------------------------------------------

model Vertical {
  id         String     @id @default(cuid())
  name       String     @unique // ej. "Uñas", "Belleza y cuidado personal", "Moda y ropa"
  slug       String     @unique
  categories Category[]

  brandProfiles    BrandProfile[]
  creatorProfiles  CreatorProfile[]
  creatorInterests CreatorInterest[]
}

model Category {
  id         String   @id @default(cuid())
  name       String // ej. "Esmaltes", "Herramientas", "Extensiones"
  slug       String
  verticalId String
  vertical   Vertical @relation(fields: [verticalId], references: [id])

  offers Offer[]

  @@unique([verticalId, slug])
}

// ----------------------------------------------------------------------------
// PERFIL DE CREADOR
// ----------------------------------------------------------------------------

enum CreatorPayoutMethod {
  BANK
  BRE_B
}

model CreatorProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName String
  bio         String?
  photoUrl    String?
  city        String?
  country     String  @default("Colombia")

  /// Nombre y apellido completo — para pagos/identidad legal, nunca se
  /// muestra en la vitrina pública (ahí solo se ve displayName, que es como
  /// el creador es conocido — ej. "Laura" en la vida real, "dani15" en
  /// redes/vitrina).
  legalName  String?
  /// Cédula del titular — la piden bancos/Bre-B para validar que la cuenta
  /// realmente es de esa persona antes de dejar transferir.
  documentId String?
  /// Celular/WhatsApp — para que una marca pueda coordinar logística
  /// (envío de producto, campañas) sin tener que pedirlo por chat.
  phone      String?

  /// Confirmación de Términos y Condiciones — se pone al registrarse, igual
  /// que BrandProfile.termsAcceptedAt.
  termsAcceptedAt DateTime?

  verticalId String?
  vertical   Vertical? @relation(fields: [verticalId], references: [id])

  /// Categorías de interés (multi-selección) — a diferencia de verticalId
  /// (heredado, uno solo), esto es lo que se usa en el onboarding para que
  /// el creador marque todas las que le interesen. Sirve para saber qué
  /// potencial de creadores hay en categorías a las que Marcolini todavía
  /// no se expande (ej. Mascotas, Moda) — ver CreatorInterest.
  interests CreatorInterest[]

  /// El código de identidad único del creador (ej. "LAURA30") — nace del
  /// nombre al registrarse. Sirve como sugerencia de partida al unirse a una
  /// marca, pero el código real que usa en cada tienda (CreatorOfferEnrollment.discountCode)
  /// es independiente por marca, porque cada tienda tiene sus propias reglas.
  baseCode String @unique

  /// "Modo Descubrible" (Fase 2 — Marcolini Discover, construido 2026-09-06):
  /// mientras esté en false, ninguna marca puede encontrar este perfil en el
  /// buscador de creadores — solo aparece en "Creadores vinculados" de las
  /// marcas a las que él mismo decidió unirse. Prende por defecto para
  /// cuentas NUEVAS (@default(true) — resuelve el problema de arranque en
  /// frío de un directorio vacío); las cuentas que ya existían de antes de
  /// este cambio conservan el valor que tenían guardado (la migración NO
  /// las toca), así que siguen invisibles hasta que ellas mismas lo
  /// prendan — ver el aviso en /creador/perfil.
  discoverable Boolean @default(true)

  /// El admin puede suspender una cuenta (ej. fraude detectado, código
  /// compartido/vendido) sin necesidad de eliminarla.
  suspended Boolean @default(false)

  /// Slug de su página pública "Mi Storefront" (ej. marcolini.co/@lauragomez)
  storefrontSlug String @unique

  /// Personalización de la vitrina pública — paletas y fuentes prearmadas
  /// (ver src/lib/creator-storefront-themes.ts para las opciones válidas),
  /// nunca color/fuente libres, para que siempre se vea bien combinado.
  storefrontPalette  String  @default("rosa-marcolini")
  storefrontFont     String  @default("clasica")
  storefrontHeadline String?

  // Datos de pago para el desembolso — el pago en sí es manual (ver
  // payment-service.ts), esto es solo dónde debe llegar la plata.
  payoutMethod      CreatorPayoutMethod?
  breBKey           String?
  bankName          String?
  bankAccountType   String?
  bankAccountNumber String?
  paymentHolderName String?

  /// Recordatorios para terminar el onboarding (no bloqueante, así que solo
  /// son un empujón) — a los 3 y 7 días de registrarse si todavía no lo
  /// completó. Ver sendOnboardingReminders en creator-onboarding-service.ts.
  /// Null = todavía no se le mandó ese recordatorio.
  onboardingReminder1SentAt DateTime?
  onboardingReminder2SentAt DateTime?

  socialLinks           CreatorSocialLink[]
  enrollments           CreatorOfferEnrollment[]
  transactions          Transaction[]
  commissions           Commission[]
  payouts               Payout[]
  instantPayoutRequests InstantPayoutRequest[]
  challengeRewards      ChallengeReward[]
  conversations         Conversation[]
  badges                CreatorBadge[]
  challengeUrgencyPings ChallengeUrgencyPing[]
  collections           Collection[]
  sampleRequests        SampleRequest[]
  invitations           EnrollmentInvitation[]
  licensableContent     LicensableContent[]
  contentLicenses       ContentLicense[]

  /// Programa de referidos — a quiénes invitó este creador (referrer) y,
  /// como mucho, por quién fue invitado él mismo (referred, único).
  referralsMade CreatorReferral[] @relation("ReferralsMade")
  referredBy    CreatorReferral?  @relation("ReferralsReceived")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Insignias por logros — se otorgan solas, una vez, dentro del cron diario
/// (ver evaluateCreatorBadges en creator-badge-service.ts). El catálogo de
/// claves válidas vive en src/lib/creator-badges.ts, no acá — así se pueden
/// agregar insignias nuevas sin migración.
model CreatorBadge {
  id String @id @default(cuid())

  creatorId String
  creator   CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  badgeKey String
  earnedAt DateTime @default(now())

  @@unique([creatorId, badgeKey])
}

model CreatorSocialLink {
  id               String         @id @default(cuid())
  creatorProfileId String
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  platform        String // Instagram, TikTok, Facebook...
  handle          String
  approxFollowers Int?
}

/// Categoría de interés marcada por el creador en el onboarding —
/// multi-selección, a diferencia de CreatorProfile.verticalId (single,
/// heredado). No implica nada operativo todavía (Marcolini solo opera en
/// Uñas hoy) — es información para saber hacia dónde expandir.
model CreatorInterest {
  id String @id @default(cuid())

  creatorProfileId String
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  verticalId String
  vertical   Vertical @relation(fields: [verticalId], references: [id])

  @@unique([creatorProfileId, verticalId])
}

// ----------------------------------------------------------------------------
// PERFIL DE MARCA
// ----------------------------------------------------------------------------

enum BrandStatus {
  PENDING // esperando aprobación del admin
  APPROVED
  REJECTED
  PAUSED
}

/// Le permite al admin forzar si una marca aparece o no en el marketplace de
/// creadores, sin importar si de verdad completó los 4 pasos de onboarding
/// (perfil, tienda conectada, cómo-te-cobramos) — pensado para que Juan pueda
/// probar visualmente el flujo del creador con marcas de prueba a medio
/// llenar, sin tener que completarles todo el onboarding real primero.
enum MarketplaceVisibilityOverride {
  AUTO // comportamiento normal: visible solo si cumple todos los requisitos reales
  FORCE_VISIBLE
  FORCE_HIDDEN
}

enum StoreType {
  SHOPIFY
  WOOCOMMERCE
  OTHER // método de código con reporte manual, sin webhook automático
}

enum StoreConnectionStatus {
  NOT_CONNECTED
  CONNECTED
  ERROR
}

/// Pasarela de pago que la marca conectó para cobrar en su propia tienda
/// Marcolini ("Mi tienda") — a diferencia de storeType (que es sobre DETECTAR
/// ventas de una tienda externa), esto es sobre COBRAR de verdad dentro de
/// Marcolini. Por ahora solo Wompi — ePayco, Mercado Pago y Addi quedan para
/// después (ver conversación del 2026-09-06: cada marca trae su propia
/// cuenta, el cobro se hace con SUS credenciales, la plata nunca pasa por
/// Marcolini).
enum PaymentProvider {
  NONE
  WOMPI
}

/// TEST usa las llaves de sandbox de la marca (para probar sin cobrar de
/// verdad) — PRODUCTION usa las reales. La marca puede dejar cargadas las
/// dos y cambiar de modo sin perder ninguna.
enum PaymentMode {
  TEST
  PRODUCTION
}

/// Modalidad de vinculación de creadores a una oferta (se explica con texto
/// claro en el Portal Marca al elegir).
enum JoinMode {
  OPEN // "Cualquier creador puede unirse automáticamente"
  APPROVAL // "Tú revisas el perfil de cada creador antes de aceptarlo"
}

model BrandProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName String
  legalName   String? // razón social
  taxId       String? // NIT
  logoUrl     String?
  description String?
  city        String?
  country     String  @default("Colombia")

  /// Perfil más sólido — para que se vea profesional y sirva también para
  /// lo tributario/facturación (ver BrandInvoice).
  websiteUrl        String?
  phone             String?
  fiscalAddress     String?
  taxRegime         String? // ej. "Responsable de IVA" / "No responsable"
  legalRepName      String? // representante legal
  legalRepId        String? // cédula del representante legal
  instagramHandle   String?
  tiktokHandle      String?
  rutDocumentUrl    String? // PDF/imagen del RUT
  camaraComercioUrl String? // PDF/imagen de Cámara de Comercio

  verticalId String?
  vertical   Vertical? @relation(fields: [verticalId], references: [id])

  status       BrandStatus @default(PENDING)
  approvedAt   DateTime?
  approvedById String? // referencia al User admin que aprobó

  marketplaceVisibilityOverride MarketplaceVisibilityOverride @default(AUTO)

  termsAcceptedAt DateTime?

  /// Confirmación del paso "Cómo te cobramos" del onboarding — la marca vio
  /// y entendió el ciclo de corte mensual, transferencia y bloqueo por
  /// impago antes de salir en vivo.
  billingAcknowledgedAt DateTime?

  storeType             StoreType             @default(OTHER)
  storeUrl              String?
  storeConnectionStatus StoreConnectionStatus @default(NOT_CONNECTED)
  storeLastSyncedAt     DateTime?
  // Credenciales de integración (en producción: cifradas / en un vault, no en texto plano)
  shopifyAccessToken    String?
  wooConsumerKey        String?
  wooConsumerSecret     String?
  /// Secreto único para verificar la firma de los webhooks entrantes (tanto
  /// Shopify como WooCommerce) — se genera al conectar la tienda.
  webhookSecret         String?

  /// Tarifa de plataforma para ESTA marca. Si es null, aplica el valor por
  /// defecto de PlatformConfig (5%) — el admin puede sobrescribirla por
  /// negociación, y la marca lo ve reflejado automáticamente en su portal.
  platformFeePercentOverride Decimal? @db.Decimal(5, 2)

  offers       Offer[]
  charges      BrandCharge[]
  invoices     BrandInvoice[]
  transactions Transaction[]
  products     Product[]

  // --------------------------------------------------------------------
  // "Mi tienda" — catálogo y checkout propios de Marcolini, independientes
  // de tener (o no) una tienda Shopify/WooCommerce conectada. Ver
  // conversación del 2026-09-06.
  // --------------------------------------------------------------------

  /// Slug único para la vitrina pública de la marca en Marcolini —
  /// marcolini.lat/{storefrontSlug}. Null hasta que la marca lo configure
  /// en "Mi tienda → Configuración".
  storefrontSlug String? @unique

  /// Envío — modelo simple por ahora (tarifa plana + umbral de envío
  /// gratis), no zonas por ciudad/región. Null = todavía no lo configuró.
  shippingFlatRate      Decimal? @db.Decimal(12, 2)
  freeShippingThreshold Decimal? @db.Decimal(12, 2)
  shippingNotes         String?

  /// Pasarela de pago de "Mi tienda" — ver PaymentProvider/PaymentMode
  /// arriba. Las 8 llaves (4 de prueba + 4 de producción) son las que Wompi
  /// le da a cada comercio en su propio panel — mismo criterio que
  /// shopifyAccessToken/wooConsumerKey arriba: en producción real,
  /// cifradas / en un vault, no en texto plano.
  paymentProvider       PaymentProvider @default(NONE)
  paymentMode           PaymentMode     @default(TEST)
  wompiPublicKeyTest    String?
  wompiPrivateKeyTest   String?
  wompiEventsKeyTest    String?
  wompiIntegrityKeyTest String?
  wompiPublicKeyProd    String?
  wompiPrivateKeyProd   String?
  wompiEventsKeyProd    String?
  wompiIntegrityKeyProd String?

  storeOrders     StoreOrder[]
  sampleRequests  SampleRequest[]
  contentLicenses ContentLicense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// OFERTA (el programa de afiliación de una marca)
// ----------------------------------------------------------------------------

enum OfferStatus {
  ACTIVE
  PAUSED
}

model Offer {
  id      String       @id @default(cuid())
  brandId String
  brand   BrandProfile @relation(fields: [brandId], references: [id], onDelete: Cascade)

  name        String
  description String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  status OfferStatus @default(ACTIVE)

  /// % que gana el creador — el 100% de este valor es del creador (modelo
  /// Awin: la marca lo paga aparte de la tarifa de Marcolini, nunca se
  /// descuenta del creador).
  defaultCommissionPercent Decimal @db.Decimal(5, 2)

  /// % de descuento que ve el comprador final al usar el código — campo
  /// independiente de la comisión, configurable también por creador.
  defaultDiscountPercent Decimal @db.Decimal(5, 2)

  joinMode JoinMode @default(OPEN)

  startDate DateTime?
  endDate   DateTime?

  enrollments  CreatorOfferEnrollment[]
  challenges   Challenge[]
  transactions Transaction[]
  invitations  EnrollmentInvitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// VINCULACIÓN CREADOR <-> OFERTA ("Creadores vinculados")
// ----------------------------------------------------------------------------

enum EnrollmentStatus {
  PENDING_APPROVAL // solo aplica si la oferta es JoinMode.APPROVAL
  ACTIVE
  REJECTED
  REMOVED
}

model CreatorOfferEnrollment {
  id String @id @default(cuid())

  creatorId String
  creator   CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  offerId String
  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)

  status EnrollmentStatus @default(ACTIVE)

  /// Comisión/descuento negociados específicamente para este creador en esta
  /// oferta — si son null, aplica el valor general de la Offer.
  commissionPercentOverride Decimal? @db.Decimal(5, 2)
  discountPercentOverride   Decimal? @db.Decimal(5, 2)

  /// El código real creado en la tienda de la marca (normalmente idéntico al
  /// baseCode del creador — solo difiere si hubo colisión con un código ya
  /// existente en esa tienda puntual).
  discountCode String

  // Referencia al objeto creado vía API en la tienda de la marca
  shopifyPriceRuleId String?
  wooCouponId        String?

  /// Control del creador sobre su propia vitrina — qué marcas se muestran
  /// ahí y en qué orden (menor primero). No afecta nada operativo, solo la
  /// página pública /c/[slug].
  storefrontVisible Boolean @default(true)
  storefrontOrder   Int     @default(0)

  transactions  Transaction[]
  conversations Conversation[]
  shipments     ProductShipment[]

  /// Se llena solo si esta vinculación nació de que la marca invitó al
  /// creador desde el buscador (ver EnrollmentInvitation) — null si el
  /// creador se unió por su cuenta.
  invitation EnrollmentInvitation?

  joinedAt DateTime @default(now())

  @@unique([offerId, creatorId])
}

// ----------------------------------------------------------------------------
// BUSCADOR DE CREADORES (la marca recluta, en vez de esperar a que el
// creador la encuentre) — ver conversación sobre Creator Score y
// reclutamiento estilo TikTok Shop "Target Collaboration".
// ----------------------------------------------------------------------------

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// La marca invita directo a un creador (encontrado en el buscador) a
/// unirse a una de sus ofertas, opcionalmente con comisión/descuento mejor
/// que el estándar — el creador solo acepta o rechaza, sin pasar por el
/// filtro normal de JoinMode.APPROVAL (la marca ya lo está aprobando de
/// entrada, al invitarlo). Si acepta, se crea la CreatorOfferEnrollment
/// real con esos valores ya aplicados.
model EnrollmentInvitation {
  id String @id @default(cuid())

  offerId String
  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)

  creatorId String
  creator   CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  commissionPercentOverride Decimal? @db.Decimal(5, 2)
  discountPercentOverride   Decimal? @db.Decimal(5, 2)
  message                   String?

  status InvitationStatus @default(PENDING)

  enrollmentId String?                 @unique
  enrollment   CreatorOfferEnrollment? @relation(fields: [enrollmentId], references: [id])

  createdAt   DateTime  @default(now())
  respondedAt DateTime?
}

// ----------------------------------------------------------------------------
// RETOS Y CAMPAÑAS
// ----------------------------------------------------------------------------

enum ChallengeType {
  GOAL_BONUS // Misión: bono por meta de ventas
  FLASH_SALE // Comisión elevada y/o descuento elevado, uno u otro o los dos
  MIX // Misión + Flash Sale juntos en una sola campaña
  LEADERBOARD // Leaderboard con premio al Top N
  WELCOME_BONUS // Bono de bienvenida (primeros N cupos)
  CONTENT_CHALLENGE // Reto de contenido (verificación manual)

  // Retirados de la app (ver lib/challenge-types.ts) — se fusionaron en
  // FLASH_SALE. Se dejan declarados acá porque Postgres no permite quitar
  // un valor de un enum sin recrear el tipo entero, y no vale la pena ese
  // riesgo solo por prolijidad. Cualquier fila vieja con estos tipos se
  // migra a FLASH_SALE en la migración que agrega este comentario — así que
  // en la práctica nunca deberían volver a aparecer.
  TEMP_COMMISSION_BOOST
  TEMP_DISCOUNT_BOOST
}

enum ChallengeStatus {
  ACTIVE
  ENDED
}

model Challenge {
  id      String @id @default(cuid())
  offerId String
  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)

  type   ChallengeType
  name   String
  status ChallengeStatus @default(ACTIVE)

  startDate DateTime
  endDate   DateTime

  /// Configuración flexible según el tipo de reto:
  /// GOAL_BONUS   -> { goalAmount, bonusAmount }
  /// FLASH_SALE   -> { newCommissionPercent?, newDiscountPercent? } — al menos uno de los dos
  /// MIX          -> { goalAmount, bonusAmount, newCommissionPercent?, newDiscountPercent? } — Misión + Flash Sale
  /// LEADERBOARD  -> { winnersCount, prizes: [amount, ...] }
  /// WELCOME_BONUS -> { slotsCount, bonusPerSlot }
  /// CONTENT_CHALLENGE -> { instructions, bonusAmount }
  config Json

  /// Solo relevante si FLASH_SALE/MIX trae el lado de descuento configurado:
  /// a diferencia de la comisión (que se calcula al vuelo, sin tocar nada
  /// externo), el descuento sí vive en la tienda real de la marca — así que
  /// subirlo y devolverlo es una acción con efecto externo que hay que
  /// recordar si ya se hizo o no. true = el código de cada creador de esta
  /// oferta está ahora mismo con el valor elevado en Shopify/WooCommerce; el
  /// cron diario (syncDiscountBoosts en challenge-service.ts) lo prende al
  /// llegar startDate y lo apaga (vuelve al % normal) al pasar endDate.
  discountBoostActive Boolean @default(false)

  /// No hay opt-in del creador para participar en una campaña (Juan,
  /// 2026-08-24) — en cambio, se le avisa apenas arranca, para que pueda
  /// adaptar su comunicación (subir su comisión, contar el descuento
  /// especial, o ir por la meta de una Misión). true = ya se le mandó ese
  /// aviso a todos los creadores vinculados a la oferta en ese momento; ver
  /// notifyCreatorsCampaignStarted en challenge-service.ts.
  startNotificationSent Boolean @default(false)

  rewards      ChallengeReward[]
  urgencyPings ChallengeUrgencyPing[]

  createdAt DateTime @default(now())
}

/// Registro de qué recordatorio de urgencia ("quedan 3 días" / "queda 1
/// día") ya se le mandó a qué creador para qué reto — evita mandarlo dos
/// veces si el cron corre más de una vez el mismo día. Ver
/// sendChallengeUrgencyReminders en challenge-service.ts.
model ChallengeUrgencyPing {
  id String @id @default(cuid())

  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  creatorId String
  creator   CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  window String // "3d" | "1d"

  sentAt DateTime @default(now())

  @@unique([challengeId, creatorId, window])
}

enum ChallengeRewardStatus {
  PENDING_REVIEW // solo CONTENT_CHALLENGE: la marca todavía no revisó la evidencia
  PENDING // ganado, en la misma ventana de espera por reembolsos que una Commission
  APPROVED // lista para el próximo pago (día 15 o adelanto)
  PAID
  REJECTED // la marca no aprobó la evidencia (solo CONTENT_CHALLENGE)
}

/// Un premio ganado por un creador en un reto — se paga por el mismo Motor
/// de Pagos que las comisiones normales (mismo hold de reembolsos, mismo
/// Payout del día 15, mismo adelanto instantáneo), pero es dinero aparte de
/// cualquier venta puntual.
model ChallengeReward {
  id          String    @id @default(cuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  creatorId String
  creator   CreatorProfile @relation(fields: [creatorId], references: [id])

  amount Decimal               @db.Decimal(12, 2)
  status ChallengeRewardStatus @default(PENDING)

  /// Solo CONTENT_CHALLENGE: lo que el creador mandó como evidencia.
  submissionUrl  String?
  submissionNote String?
  reviewedAt     DateTime?
  reviewedById   String? // userId de la marca que aprobó/rechazó

  holdUntil  DateTime?
  approvedAt DateTime?

  /// A qué corte del día 1 quedó asociado, solo para el desglose del aviso
  /// de cobro de esa marca — el pago al creador ya NO depende de que ese
  /// corte esté verificado (ver payment-service.ts): Marcolini le paga en
  /// su fecha normal así la marca esté atrasada o bloqueada, nunca al
  /// revés.
  brandChargeId String?
  brandCharge   BrandCharge? @relation(fields: [brandChargeId], references: [id])

  payoutId String?
  payout   Payout? @relation(fields: [payoutId], references: [id])

  instantPayoutRequestId String?
  instantPayoutRequest   InstantPayoutRequest? @relation(fields: [instantPayoutRequestId], references: [id])

  createdAt DateTime @default(now())

  @@unique([challengeId, creatorId])
}

enum ReferralStatus {
  PENDING // el referido ya se registró, todavía no hizo su primera venta
  QUALIFIED // el referido ya vendió por primera vez — bono listo para pagar
  PAID // el admin ya transfirió el bono al que invitó
}

/// Programa de referidos entre creadores: un creador ya activo invita a otro
/// con su propio baseCode (ej. "LAURA30") — si el nuevo creador se registra
/// con ese código y genera su primera venta, quien invitó gana un bono fijo
/// de $20.000 COP. El pago del bono es manual, igual que un corte de marca
/// o un pago a creador — el admin lo marca pagado desde /admin/referidos
/// (ver referral-service.ts).
model CreatorReferral {
  id String @id @default(cuid())

  referrerId String
  referrer   CreatorProfile @relation("ReferralsMade", fields: [referrerId], references: [id])

  /// Único — un creador solo puede haber sido invitado por una persona.
  referredId String         @unique
  referred   CreatorProfile @relation("ReferralsReceived", fields: [referredId], references: [id])

  bonusAmount Decimal        @default(20000) @db.Decimal(12, 2)
  status      ReferralStatus @default(PENDING)

  qualifiedAt DateTime?
  paidAt      DateTime?

  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// MOTOR DE ATRIBUCIÓN — Transacciones detectadas vía Shopify/WooCommerce
// ----------------------------------------------------------------------------

enum TransactionSource {
  SHOPIFY
  WOOCOMMERCE
  MANUAL // reporte manual para marcas sin integración (StoreType.OTHER)
  MARCOLINI // venta nativa por el checkout de "Mi tienda" (ver StoreOrder)
}

enum TransactionStatus {
  COMPLETED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Transaction {
  id String @id @default(cuid())

  brandId String
  brand   BrandProfile @relation(fields: [brandId], references: [id])

  offerId String
  offer   Offer  @relation(fields: [offerId], references: [id])

  creatorId String
  creator   CreatorProfile @relation(fields: [creatorId], references: [id])

  enrollmentId String
  enrollment   CreatorOfferEnrollment @relation(fields: [enrollmentId], references: [id])

  source          TransactionSource
  externalOrderId String // id de la orden en Shopify/WooCommerce — para MANUAL, se genera solo

  grossAmount    Decimal @db.Decimal(12, 2) // precio de lista
  discountAmount Decimal @db.Decimal(12, 2) // lo que no pagó el cliente
  netAmount      Decimal @db.Decimal(12, 2) // lo que realmente pagó el cliente (base de la comisión)

  /// Solo se usa con source MANUAL — la referencia que la marca escribió al
  /// reportar la venta a mano (ej. "Pedido de Instagram #4521"), para poder
  /// auditarla después. Null en ventas de Shopify/WooCommerce.
  note String?

  /// Correo del comprador — cuando el webhook de la tienda lo manda (o la
  /// marca lo escribe en una venta manual). Nunca se muestra en ningún
  /// lado de la app; solo existe para el detector de fraude "comprador =
  /// creador" (ver checkBuyerIsCreator en attribution-service.ts). Null si
  /// no vino en el pedido.
  customerEmail String?

  status TransactionStatus @default(COMPLETED)

  occurredAt DateTime
  refundedAt DateTime?

  commission Commission?

  /// Solo cuando source = MARCOLINI — el pedido nativo de "Mi tienda" que
  /// generó esta Transaction.
  storeOrder StoreOrder?

  createdAt DateTime @default(now())

  /// El mismo pedido nunca puede convertirse en dos Transactions — protege
  /// contra reintentos de webhook (Shopify/WooCommerce reenvían si no
  /// reciben 200 a tiempo).
  @@unique([brandId, source, externalOrderId])
}

// ----------------------------------------------------------------------------
// "MI TIENDA" — CHECKOUT NATIVO (carrito, pedidos y pago con Wompi)
// ----------------------------------------------------------------------------

enum StoreOrderStatus {
  PENDING // se creó, esperando que el comprador pague en Wompi
  PAID // Wompi confirmó la transacción como aprobada (o es una muestra, $0)
  FAILED // Wompi la rechazó / declinó / dio error
  EXPIRED // nunca se completó y el link/reference quedó vencido
}

enum ProductType {
  PHYSICAL // se despacha por envío — comportamiento de siempre
  SERVICE // clase/asesoría presencial o virtual — se "cumple" con una reserva, no con un envío
}

enum ServiceModality {
  VIRTUAL // por videollamada — ver Product.serviceLocation para el link
  PRESENCIAL // en un lugar físico — ver Product.serviceLocation para la dirección
}

enum StoreOrderKind {
  PURCHASE // pedido real, cobrado con Wompi
  SAMPLE // muestra gratis aprobada — ver SampleRequest
}

/// Un pedido dentro de "Mi tienda" — normal (PURCHASE, pagado con Wompi
/// desde la vitrina pública en marcolini.lat/t/{storefrontSlug}) o una
/// muestra gratis aprobada (SAMPLE, $0, ver SampleRequest). Si el
/// comprador escribe el código de un creador en un PURCHASE y es válido,
/// al confirmarse el pago se crea una Transaction (source MARCOLINI) igual
/// que con Shopify/WooCommerce, para que el Motor de Comisiones la procese
/// normal — las muestras nunca generan Transaction/comisión, son gratis.
model StoreOrder {
  id String @id @default(cuid())

  brandId String
  brand   BrandProfile @relation(fields: [brandId], references: [id], onDelete: Cascade)

  kind StoreOrderKind @default(PURCHASE)

  /// Referencia única enviada a Wompi como `reference` — también es la que
  /// llega de vuelta en el webhook para encontrar este pedido.
  reference String @unique

  buyerName  String
  buyerEmail String
  buyerPhone String

  /// Null en un pedido 100% de servicios — ver createStoreOrder, que exige
  /// dirección solo cuando el carrito trae al menos un producto PHYSICAL.
  /// Un carrito nunca mezcla PHYSICAL con SERVICE (ver la misma función),
  /// así que nunca hace falta envío Y reserva a la vez en el mismo pedido.
  shippingAddress String?
  shippingCity    String?
  shippingNotes   String?

  /// Solo en un pedido de servicios — la fecha/hora que pidió el
  /// comprador al pagar. Es una preferencia, no una reserva confirmada:
  /// la marca la confirma (o ajusta) desde Pedidos — ver
  /// StoreOrderItem.serviceConfirmedAt.
  servicePreferredAt DateTime?

  /// Código de descuento del creador, tal como lo escribió el comprador —
  /// null si compró directo, sin código. Ver findEnrollmentByDiscountCode.
  discountCode String?

  subtotalCents Int // suma de los productos, precio de lista
  discountCents Int @default(0)
  shippingCents Int @default(0)
  totalCents    Int // lo que realmente se le cobra a Wompi

  currency String @default("COP")

  /// Modo de la marca al momento de crear el pedido (TEST/PRODUCTION) — se
  /// guarda aparte de BrandProfile.paymentMode porque la marca lo pudo
  /// cambiar después y el pedido ya viejo debe seguir apuntando a las
  /// llaves con las que en verdad se cobró.
  paymentMode PaymentMode

  status StoreOrderStatus @default(PENDING)

  wompiTransactionId String? // id que devuelve Wompi — para consultarla por API
  wompiStatus        String? // estado crudo que mandó Wompi (APPROVED/DECLINED/...)

  /// Se llena solo si status = PAID y el pedido logró atribuirse (o no —
  /// ver TransactionSource.MARCOLINI arriba). Null en ventas sin código.
  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  items StoreOrderItem[]

  /// Solo cuando kind = SAMPLE — la solicitud que originó este pedido.
  sampleRequest SampleRequest?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  paidAt    DateTime?

  @@index([brandId, status])
}

model StoreOrderItem {
  id String @id @default(cuid())

  orderId String
  order   StoreOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Puede quedar null si el producto se borra después — el pedido guarda
  /// su propia foto de nombre/precio, así que no depende de que exista.
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  name           String // foto del nombre al momento de la compra
  unitPriceCents Int // foto del precio unitario
  quantity       Int
  imageUrl       String?

  /// Solo si el producto era tipo SERVICE al momento de la compra — la
  /// marca confirma acá la fecha/hora real (puede ajustar la que pidió el
  /// comprador en StoreOrder.servicePreferredAt) y, si es virtual, el link
  /// de la reunión. Null hasta que la marca confirme desde Pedidos.
  serviceConfirmedAt DateTime?
  serviceMeetingInfo String?
}

// ----------------------------------------------------------------------------
// MUESTRAS (inspirado en TikTok Shop) — dos direcciones posibles:
// - CREATOR pide (pull): la marca habilita un producto con un pool de
//   unidades, el creador lo ve en su portal y lo pide con un clic.
// - BRAND ofrece (push, "reclutamiento" desde el buscador de creadores): la
//   marca le ofrece la muestra a un creador puntual sin que él la haya
//   pedido; el creador solo acepta (pone sus datos de envío) o rechaza.
// En ambos casos, si termina aprobada, se crea un StoreOrder $0 (kind
// SAMPLE) con los datos de envío del creador.
// ----------------------------------------------------------------------------

enum SampleRequestStatus {
  PENDING // el creador la pidió, la marca todavía no decide
  OFFERED // la marca se la ofreció, el creador todavía no responde
  APPROVED
  REJECTED
}

enum SampleRequestInitiator {
  CREATOR
  BRAND
}

model SampleRequest {
  id String @id @default(cuid())

  brandId String
  brand   BrandProfile @relation(fields: [brandId], references: [id], onDelete: Cascade)

  creatorId String
  creator   CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity Int @default(1)

  initiatedBy SampleRequestInitiator @default(CREATOR)

  /// Nota opcional — del creador a la marca cuando él la pide, o de la
  /// marca al creador cuando ella la ofrece (ej. "queremos que la pruebes
  /// para tu contenido de skincare").
  message String?

  /// Igual que StoreOrder — se captura en el momento, no depende de un
  /// perfil de direcciones aparte. Quedan null mientras la oferta está en
  /// OFFERED (la marca todavía no sabe la dirección) — se llenan cuando el
  /// creador acepta, justo antes de aprobar y crear el pedido.
  shippingName    String?
  shippingPhone   String?
  shippingAddress String?
  shippingCity    String?
  shippingNotes   String?

  status         SampleRequestStatus @default(PENDING)
  rejectedReason String?
  reviewedAt     DateTime?

  /// Se llena solo si status = APPROVED — el pedido $0 que se creó.
  orderId String?     @unique
  order   StoreOrder? @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())

  /// Evita que el mismo creador spamee el mismo producto con solicitudes
  /// mientras ya tiene una pendiente sin resolver.
  @@index([brandId, status])
  @@index([creatorId, status])
}

// ----------------------------------------------------------------------------
// MOTOR DE COMISIONES
// ----------------------------------------------------------------------------

enum CommissionStatus {
  PENDING // dentro de la ventana de 15 días de espera por reembolsos
  APPROVED // ya se puede incluir en el próximo pago del día 15
  PAID
  REVERSED // hubo reembolso/contracargo, se anula
}

model Commission {
  id String @id @default(cuid())

  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  /// 100% para el creador — la marca lo factura/paga completo, sin descuento
  /// de la tarifa de plataforma (modelo Awin).
  creatorCommissionAmount Decimal @db.Decimal(12, 2)

  /// Tarifa de Marcolini, cobrada aparte a la marca.
  platformFeeAmount    Decimal @db.Decimal(12, 2)
  platformFeeVatAmount Decimal @db.Decimal(12, 2) // IVA sobre la tarifa (pendiente de confirmación contable)

  status CommissionStatus @default(PENDING)

  /// Fecha en la que se levanta la espera de 15 días por reembolsos.
  holdUntil DateTime

  approvedAt DateTime?
  reversedAt DateTime?

  payoutId String?
  payout   Payout? @relation(fields: [payoutId], references: [id])

  instantPayoutRequestId String?
  instantPayoutRequest   InstantPayoutRequest? @relation(fields: [instantPayoutRequestId], references: [id])

  /// A qué corte del día 1 quedó asociada, solo para el desglose del aviso
  /// de cobro de esa marca — el pago al creador ya NO depende de que ese
  /// corte esté verificado (ver payment-service.ts): Marcolini le paga en
  /// su fecha normal así la marca esté atrasada o bloqueada, nunca al
  /// revés.
  brandChargeId String?
  brandCharge   BrandCharge? @relation(fields: [brandChargeId], references: [id])

  createdAt        DateTime        @default(now())
  creatorProfile   CreatorProfile? @relation(fields: [creatorProfileId], references: [id])
  creatorProfileId String?
}

// ----------------------------------------------------------------------------
// MOTOR DE PAGOS (ePayco — Pagos Divididos)
// ----------------------------------------------------------------------------

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

/// Desembolso del día 15 a un creador — agrupa todas sus comisiones
/// aprobadas del período.
model Payout {
  id String @id @default(cuid())

  creatorId String
  creator   CreatorProfile @relation(fields: [creatorId], references: [id])

  periodStart DateTime
  periodEnd   DateTime

  totalAmount Decimal      @db.Decimal(12, 2)
  status      PayoutStatus @default(PENDING)

  epaycoTransactionRef String?
  paidAt               DateTime?

  commissions      Commission[]
  challengeRewards ChallengeReward[]
  contentLicenses  ContentLicense[]

  createdAt DateTime @default(now())
}

enum BrandChargeStatus {
  PENDING // corte generado, esperando comprobante — el contador de dueAt está corriendo
  PROOF_SUBMITTED // la marca subió comprobante, esperando verificación del admin
  PAID // el admin verificó el comprobante
  OVERDUE // pasó dueAt sin comprobante verificado — la marca queda bloqueada (ver isBrandPaymentLocked) pero sigue en marketplace y los códigos de creadores siguen funcionando (Nivel 2)
  DEACTIVATED // pasó deactivationDueAt sin comprobante verificado — desaparece del marketplace y sus códigos dejan de atribuir ventas (Nivel 3), además de seguir bloqueada como en OVERDUE
}

/// Corte del día 1: cubre comisiones + tarifa de plataforma + IVA del
/// período. La marca paga por transferencia directa (QR/Bre-B, ver
/// PlatformConfig.paymentInstructions) y sube su comprobante en la
/// plataforma — no hay cobro automático a tarjeta ni procesador de pagos de
/// por medio. Si no se verifica el pago antes de `dueAt`, la marca queda
/// bloqueada (ver isBrandPaymentLocked en payment-service.ts) hasta
/// regularizar. A los creadores se les sigue pagando en su fecha normal sin
/// importar el estado de este corte — Marcolini asume ese riesgo, nunca el
/// creador.
model BrandCharge {
  id String @id @default(cuid())

  brandId String
  brand   BrandProfile @relation(fields: [brandId], references: [id])

  periodStart DateTime
  periodEnd   DateTime

  totalAmount Decimal           @db.Decimal(12, 2)
  status      BrandChargeStatus @default(PENDING)

  /// Fecha límite fija (createdAt + PlatformConfig.paymentGraceHours) para
  /// subir y que se verifique el comprobante — no se corre aunque la marca
  /// entre a mirar el aviso varios días después.
  dueAt DateTime

  /// El aviso de cobro que se genera al crear el corte (monto, desglose,
  /// instrucciones de pago, fecha límite) — se muestra en el dashboard y se
  /// manda por correo.
  pdfUrl String?

  proofUrl            String?
  proofSubmittedAt    DateTime?
  proofRejectedAt     DateTime?
  proofRejectedReason String?

  /// Marcan si ya se mandó el recordatorio de "te quedan 48h/24h" — para no
  /// reenviarlo cada vez que corre el cron mientras el corte siga abierto.
  reminder48SentAt DateTime?
  reminder24SentAt DateTime?

  /// Fecha límite (Nivel 2 → Nivel 3): cuando pasa OVERDUE sin comprobante
  /// verificado, se calcula sumando PlatformConfig.deactivationGraceHours en
  /// horas hábiles colombianas (ver addBusinessHours) desde el momento en
  /// que quedó OVERDUE. Si se llega sin pagar, el corte pasa a DEACTIVATED.
  deactivationDueAt DateTime?

  /// Marca si ya se mandó el aviso de "tu servicio se va a desactivar" —
  /// para no reenviarlo cada corrida del cron mientras siga OVERDUE.
  deactivationReminderSentAt DateTime?

  /// El momento real en que el corte pasó a DEACTIVATED (lo pone
  /// deactivateOverdueBrands) — a diferencia de deactivationDueAt (el
  /// plazo límite, redondeado a las 3pm), esto es la hora exacta en que
  /// pasó, para mostrarla tal cual en la pantalla de Nivel 3.
  deactivatedAt DateTime?

  paidAt           DateTime?
  verifiedByUserId String? // userId del admin que verificó el comprobante

  commissions      Commission[]
  challengeRewards ChallengeReward[]
  contentLicenses  ContentLicense[]

  createdAt DateTime @default(now())
}

/// La factura electrónica de verdad se genera por fuera (proveedor de
/// facturación electrónica) — Marcolini le manda qué cobrar, y de vuelta
/// llega un PDF. Este modelo es solo el registro de ese PDF ya generado,
/// para que la marca lo pueda ver y descargar desde su portal.
model BrandInvoice {
  id String @id @default(cuid())

  brandId String
  brand   BrandProfile @relation(fields: [brandId], references: [id], onDelete: Cascade)

  period String // ej. "2026-08" (mes que factura)
  amount Decimal @db.Decimal(12, 2)
  pdfUrl String
  note   String?

  uploadedByUserId String

  createdAt DateTime @default(now())
}

enum InstantPayoutStatus {
  REQUESTED
  PROCESSED
  FAILED
}

/// Cobro anticipado: el creador adelanta una comisión ya aprobada antes del
/// día 15, pagando un fee del 5% — ese 5% es ingreso de Marcolini.
model InstantPayoutRequest {
  id String @id @default(cuid())

  creatorId String
  creator   CreatorProfile @relation(fields: [creatorId], references: [id])

  amountRequested Decimal @db.Decimal(12, 2)
  feeAmount       Decimal @db.Decimal(12, 2) // 5% — ingreso de Marcolini

  status      InstantPayoutStatus @default(REQUESTED)
  processedAt DateTime?

  commissions      Commission[]
  challengeRewards ChallengeReward[]

  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// CONFIGURACIÓN GLOBAL DE LA PLATAFORMA (Panel Admin)
// ----------------------------------------------------------------------------

/// Tabla de una sola fila — los números que el admin puede ajustar sin tocar
/// código: tarifa por defecto, días de cobro/pago, ventana de reembolsos.
model PlatformConfig {
  id                        String  @id @default("singleton")
  defaultPlatformFeePercent Decimal @default(5.0) @db.Decimal(5, 2)
  vatPercent                Decimal @default(19.0) @db.Decimal(5, 2)
  chargeDayOfMonth          Int     @default(1)
  payoutDayOfMonth          Int     @default(15)
  refundHoldDays            Int     @default(15)
  instantPayoutFeePercent   Decimal @default(5.0) @db.Decimal(5, 2)

  /// % que se queda Marcolini de cada licencia de contenido (ver
  /// ContentLicense) — se descuenta del fee que paga la marca antes de
  /// liquidarle su parte al creador. Aparte de defaultPlatformFeePercent
  /// porque ahí el modelo es distinto (Awin: la marca paga la comisión del
  /// creador completa + la tarifa de Marcolini aparte); acá Marcolini
  /// retiene su parte del mismo fee, no cobra algo adicional.
  contentLicenseCommissionPercent Decimal @default(20.0) @db.Decimal(5, 2)

  /// Cómo le pagan las marcas a Marcolini — texto libre (cuenta bancaria,
  /// Nequi, llave Bre-B, lo que aplique) más un QR opcional, mostrados en
  /// cada aviso de cobro. Editable desde el Panel Admin, sin depender de un
  /// deploy.
  paymentInstructions String?
  paymentQrImageUrl   String?

  /// Horas hábiles desde que se genera el corte (Nivel 1) hasta que, sin
  /// comprobante verificado, la marca queda temporalmente inhabilitada
  /// (Nivel 2) — ver addBusinessHours en lib/colombian-business-days.ts.
  paymentGraceHours Int @default(72)

  /// Horas hábiles desde que la marca queda inhabilitada (Nivel 2) hasta
  /// que, sin comprobante verificado, el servicio se desactiva del todo
  /// (Nivel 3): desaparece del marketplace y sus códigos dejan de
  /// atribuir ventas.
  deactivationGraceHours Int @default(72)

  updatedAt DateTime @updatedAt
}

/// Costos operativos que el admin ingresa manualmente — cada fila es UN
/// gasto puntual (ej. "Compra del dominio" $150.000, "Pago servidor"
/// $50.000), no el total del mes: el Panel de Rentabilidad suma todas las
/// filas de un mes para el total y las lista aparte, para poder
/// identificar en qué se fue la plata. El ingreso (tarifa de plataforma)
/// ya se calcula solo; el costo no puede saberlo el sistema por su cuenta.
model MonthlyOperatingCost {
  id     String   @id @default(cuid())
  month  DateTime // se guarda como el día 1 del mes correspondiente
  label  String // qué es el gasto — ej. "Compra del dominio", "Pago servidor"
  amount Decimal  @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([month])
}

// ----------------------------------------------------------------------------
// LICENCIAMIENTO DE CONTENIDO (alquiler de video/post para pauta paga)
// ----------------------------------------------------------------------------

enum ContentPlatform {
  INSTAGRAM
  TIKTOK
}

/// Una pieza de contenido YA publicada (Instagram/TikTok) que el creador
/// ofrece para que una marca "alquile" el derecho de reusarla como pauta
/// paga (Meta/TikTok Ads) por un tiempo determinado. No se sube el video de
/// nuevo — el link al post ya publicado, más una captura tomada al momento
/// de publicar el listado, es lo que identifica exactamente de qué pieza se
/// trata (y sirve de evidencia si el creador la borra o edita después de
/// cobrar). El creador fija su propio precio, por bloques de 30 días — ver
/// ContentLicense.pricePer30Days y content-license-service.ts.
model LicensableContent {
  id String @id @default(cuid())

  creatorId String
  creator   CreatorProfile @relation(fields: [creatorId], references: [id])

  platform   ContentPlatform
  contentUrl String

  screenshotUrl String

  caption String? // para que la marca sepa de qué se trata sin salir a ver el link

  pricePer30Days Decimal @db.Decimal(12, 2)

  /// El creador lo puede retirar del catálogo sin borrar el historial de
  /// licencias ya vendidas sobre él.
  active Boolean @default(true)

  licenses ContentLicense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ContentLicenseStatus {
  APPROVED // ya se puede facturar a la marca y liquidar al creador
  PAID // el corte de la marca y el payout del creador ya se liquidaron
  VOIDED // un admin lo anuló (disputa, contenido dado de baja, etc.) — no se cobra ni se paga
}

/// Una marca alquiló el derecho de uso de un LicensableContent por
/// `durationDays`. Es un fee fijo aparte del motor de atribución por código
/// de descuento — no hay venta ni comisión de por medio. El fee lo paga la
/// marca en su próximo corte (se suma a chargeBrandForPeriod, igual que un
/// ChallengeReward) y la parte del creador se liquida en su próximo pago
/// (se suma en payoutCreator) — sin ventana de espera por reembolso, porque
/// no hay producto que puedan devolver.
model ContentLicense {
  id String @id @default(cuid())

  contentId String
  content   LicensableContent @relation(fields: [contentId], references: [id])

  brandId String
  brand   BrandProfile @relation(fields: [brandId], references: [id])

  creatorId String
  creator   CreatorProfile @relation(fields: [creatorId], references: [id])

  durationDays Int // múltiplo de 30 (30 / 60 / 90)

  feeAmount         Decimal @db.Decimal(12, 2) // lo que paga la marca
  platformCutAmount Decimal @db.Decimal(12, 2) // comisión de Marcolini (contentLicenseCommissionPercent)
  creatorNetAmount  Decimal @db.Decimal(12, 2) // feeAmount - platformCutAmount, lo que recibe el creador

  status ContentLicenseStatus @default(APPROVED)

  startsAt DateTime @default(now())
  endsAt   DateTime // startsAt + durationDays — pasada esta fecha el permiso de uso vence

  brandChargeId String?
  brandCharge   BrandCharge? @relation(fields: [brandChargeId], references: [id])

  payoutId String?
  payout   Payout? @relation(fields: [payoutId], references: [id])

  createdAt DateTime @default(now())
}

/// Contenido legal editable desde el Panel Admin (ej. Términos y
/// Condiciones) sin depender de un desarrollador para cambiar una palabra.
model LegalContent {
  id    String @id @default(cuid())
  key   String @unique // ej. "terms"
  title String
  body  String @db.Text

  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// NOTIFICACIONES
// ----------------------------------------------------------------------------

/// Token de dispositivo para notificaciones push (APNs / FCM). No se usa
/// todavía — existe desde ahora para que, cuando se construya la app móvil
/// (iOS/Android), no haga falta una migración nueva solo para esto.
model DeviceToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  platform String // "ios" | "android"
  token    String @unique

  createdAt DateTime @default(now())
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    String // clave de NotificationTypeConfig — ej. "SALE_COMMISSION", "BRAND_APPROVED"
  message String
  read    Boolean @default(false)

  /// SENT = ya se envió (comportamiento de siempre). PENDING_REVIEW = el
  /// tipo está en modo Manual (ver NotificationTypeConfig) — existe pero
  /// todavía no se mandó por push/correo, espera que un admin la apruebe
  /// desde Admin → Notificaciones. DISCARDED = un admin la descartó.
  status NotificationDeliveryStatus @default(SENT)

  createdAt DateTime @default(now())
}

enum NotificationDeliveryStatus {
  SENT
  PENDING_REVIEW
  DISCARDED
}

enum NotificationAudience {
  CREATOR
  BRAND
  ADMIN
}

enum NotificationMode {
  AUTOMATIC // se manda sola en el momento del evento
  MANUAL // queda pendiente de aprobar en Admin → Notificaciones antes de salir
}

/// Un renglón por cada tipo de notificación que existe en la plataforma —
/// es el catálogo editable desde Admin → Notificaciones (nueva pestaña):
/// activarla o no, que sea automática o quede pendiente de aprobación, por
/// qué canales sale, y el texto exacto (con {placeholders}) que se manda.
/// `createNotification` (notification-service.ts) es el único lugar que la
/// lee — cualquier tipo nuevo que se agregue al código y no tenga fila acá
/// simplemente usa los valores por defecto (activo, automático, solo App).
model NotificationTypeConfig {
  id String @id @default(cuid())

  /// Coincide 1 a 1 con el `type` que se guarda en Notification.
  key      String               @unique
  label    String // nombre legible para el panel admin, ej. "Venta generada (creador)"
  audience NotificationAudience

  enabled Boolean          @default(true)
  mode    NotificationMode @default(AUTOMATIC)

  /// Canal "App": queda en su bandeja de Notificaciones dentro de Marcolini
  /// + push (van juntos, es la misma tubería). Canal "Correo": además le
  /// llega un correo aparte — para los tipos que ya tenían una plantilla de
  /// correo propia (con su propio diseño), esta casilla solo prende/apaga
  /// ESE correo; para los que no tenían, se manda un correo simple con este
  /// mismo texto.
  channelApp   Boolean @default(true)
  channelEmail Boolean @default(false)

  /// Texto editable — usa {nombreDeVariable} para los datos que cambian en
  /// cada envío (ver `placeholders` para saber cuáles aplican acá).
  messageTemplate String @db.Text

  /// Lista separada por comas de los nombres de variable válidos para este
  /// tipo (ej. "marca,monto") — solo informativo, para mostrarse como ayuda
  /// en el editor del panel admin.
  placeholders String @default("")

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// COMUNICADOS (broadcast del admin a todas las marcas o a todos los creadores)
// ----------------------------------------------------------------------------

enum BroadcastAudience {
  BRANDS
  CREATORS
}

enum BroadcastChannel {
  EMAIL
  NOTIFICATION // vía Notification — el mismo canal que se vuelve push apenas exista la app móvil
}

model Broadcast {
  id String @id @default(cuid())

  audience BroadcastAudience
  channel  BroadcastChannel

  subject String
  body    String @db.Text

  recipientCount Int

  sentByUserId String

  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// COLA DE ANTIFRAUDE (Fase 1 — reglas básicas del Panel Admin)
// ----------------------------------------------------------------------------

enum FraudFlagStatus {
  PENDING_REVIEW
  CLEARED
  CONFIRMED_FRAUD
}

model FraudFlag {
  id            String  @id @default(cuid())
  /// Sin relación real en el schema (id suelto) — no todos los detectores
  /// tienen una venta puntual de la cual colgarse (ej. cuentas duplicadas).
  /// Null cuando la señal no viene de una transacción específica.
  transactionId String?
  reason        String // ej. "email comprador = email creador", "pico anormal de órdenes con este código"

  status FraudFlagStatus @default(PENDING_REVIEW)

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
}

// ----------------------------------------------------------------------------
// MENSAJERÍA (solo entre una marca y sus creadores YA vinculados — nunca un
// directorio abierto de búsqueda de creadores para las marcas)
// ----------------------------------------------------------------------------

model Conversation {
  id String @id @default(cuid())

  enrollmentId String
  enrollment   CreatorOfferEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  creatorId String
  creator   CreatorProfile @relation(fields: [creatorId], references: [id])

  messages Message[]

  createdAt DateTime @default(now())

  @@unique([enrollmentId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderUserId String
  body         String

  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// ENVÍO DE PRODUCTO (dentro de la misma relación marca↔creador vinculado —
// el creador pide, o la marca ofrece, un producto físico como parte de la
// colaboración)
// ----------------------------------------------------------------------------

enum ShipmentStatus {
  REQUESTED // el creador lo pidió, la marca todavía no lo despacha
  SENT
  DELIVERED
}

enum ShipmentRequestedBy {
  CREATOR
  BRAND
}

model ProductShipment {
  id String @id @default(cuid())

  enrollmentId String
  enrollment   CreatorOfferEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  requestedBy ShipmentRequestedBy
  description String

  /// Dirección de envío — se captura en el momento (no se guarda un perfil
  /// de direcciones aparte), porque puede cambiar de un envío a otro.
  shippingAddress String

  status ShipmentStatus @default(REQUESTED)

  carrier        String?
  trackingNumber String?

  sentAt      DateTime?
  deliveredAt DateTime?

  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// CATÁLOGO DE PRODUCTOS Y COLECCIONES CURADAS
// (importado de Shopify/WooCommerce — ver product-sync-service.ts — para que
// el creador pueda armar "colecciones" temáticas de productos puntuales en
// su vitrina, en vez de solo listar las marcas a las que está unido)
// ----------------------------------------------------------------------------

model Product {
  id      String       @id @default(cuid())
  brandId String
  brand   BrandProfile @relation(fields: [brandId], references: [id], onDelete: Cascade)

  /// ID del producto en la tienda real (Shopify/WooCommerce) — la clave para
  /// no duplicarlo en cada sincronización (ver @@unique abajo).
  externalId String

  name           String
  /// Solo lo llenan los productos creados a mano en "Mi tienda" — los
  /// sincronizados de Shopify/WooCommerce no traen descripción hoy.
  description    String?
  imageUrl       String?
  price          Decimal  @db.Decimal(12, 2)
  /// Precio "antes" — Shopify: compare_at_price, WooCommerce: regular_price
  /// (cuando hay sale_price). Null si no está en oferta.
  compareAtPrice Decimal? @db.Decimal(12, 2)
  currency       String   @default("COP")

  /// URL real del producto en la tienda — en Shopify se arma como
  /// `{dominio}/products/{handle}`, en WooCommerce es el `permalink` que
  /// devuelve su propia API tal cual. A partir de esto (y el storeType de la
  /// marca) se arma el link con o sin código — ver buildProductLink en
  /// src/lib/brand-store-link.ts.
  url String

  /// Categoría de la tienda a la que pertenece — solo se sincroniza para
  /// WooCommerce por ahora (viene directo en su API de productos). En
  /// Shopify las "colecciones" son una llamada aparte por colección, más
  /// costosa de sincronizar — queda para una fase futura, por eso este
  /// campo queda null ahí.
  category String?

  /// false cuando ya no aparece en la sincronización más reciente (se quitó
  /// de la tienda, o se despublicó) — no se borra la fila para no romper
  /// colecciones de creadores que ya lo habían agregado; solo deja de
  /// ofrecerse para agregar productos nuevos.
  available Boolean @default(true)

  /// Hasta 3 por marca — lo hace cumplir setProductFeatured en
  /// product-service.ts. Aparecen primero como "sugeridos" cuando un
  /// creador arma una colección.
  featured Boolean @default(false)

  /// true = lo creó la marca a mano en "Mi tienda" (ver
  /// brand-store-product-service.ts) — false = vino sincronizado de
  /// Shopify/WooCommerce. Separa los dos mundos: la sincronización nunca
  /// toca un producto manual, y "Mi tienda" nunca deja editar uno
  /// sincronizado (se edita desde la tienda real, no desde acá).
  manual Boolean @default(false)

  /// Solo para productos manuales — la ruta de su página dentro de la
  /// vitrina de Marcolini (marcolini.lat/{storefrontSlug}/{slug}). Null en
  /// productos sincronizados (esos usan `url`, el link real de su tienda).
  slug String?

  /// Solo para productos manuales — null = no se controla stock (siempre
  /// disponible). 0 no bloquea la venta solo, lo hace junto con `available`.
  /// En un producto SERVICE, este mismo campo se reusa como "cupos
  /// disponibles" (cuántas reservas se pueden vender) — mismo concepto de
  /// disponibilidad limitada, sin agregar un campo aparte.
  stock Int?

  /// Solo lo trae un producto manual — los sincronizados de Shopify/
  /// WooCommerce son siempre PHYSICAL (no hay forma de marcar un producto
  /// como servicio desde esas plataformas todavía).
  type ProductType @default(PHYSICAL)

  /// Los tres siguientes solo aplican cuando type = SERVICE — null en
  /// cualquier producto PHYSICAL.
  serviceModality        ServiceModality?
  serviceDurationMinutes Int?
  /// Dirección si serviceModality = PRESENCIAL, o el link/instrucciones
  /// por defecto de la videollamada si es VIRTUAL — la marca lo puede
  /// ajustar por reserva puntual al confirmarla (ver
  /// StoreOrderItem.serviceMeetingInfo).
  serviceLocation        String?

  /// Muestras (inspirado en TikTok Shop) — cualquier producto (manual o
  /// sincronizado) se puede habilitar para que los creadores lo pidan
  /// gratis. `sampleStock` es un pool aparte del stock/venta normal, y
  /// nunca se toca en la sincronización de Shopify/WooCommerce (ver
  /// product-sync-service.ts, que no incluye estos campos en su update).
  /// Solo visible en el portal de creador, nunca en la vitrina pública.
  sampleEnabled Boolean @default(false)
  sampleStock   Int     @default(0)

  /// Instrucciones de la marca para quien pida la muestra — qué contenido
  /// espera, mensajes clave/hashtags, y en cuántos días espera que se
  /// publique. Todo opcional; se le muestra al creador ANTES de pedir la
  /// muestra (no solo después de aprobada), para que sepa a qué se está
  /// comprometiendo.
  sampleContentType  String?
  sampleInstructions String?
  sampleDeadlineDays Int?

  collectionItems CollectionProduct[]
  storeOrderItems StoreOrderItem[]
  sampleRequests  SampleRequest[]

  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([brandId, externalId])
  @@unique([brandId, slug])
  @@index([brandId, featured])
}

/// Mini-catálogo curado por el creador — ej. "En mi mesa de trabajo", "Mis
/// must-haves" — se muestra como sección en su vitrina pública, arriba de
/// la lista de marcas (ver src/app/c/[slug]/page.tsx).
model Collection {
  id        String         @id @default(cuid())
  creatorId String
  creator   CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  name        String
  description String?
  order       Int     @default(0)
  visible     Boolean @default(true)

  items CollectionProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CollectionProduct {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  order        Int        @default(0)

  createdAt DateTime @default(now())

  @@unique([collectionId, productId])
}
