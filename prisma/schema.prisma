// ============================================================================
// MARCOLINI — esquema de base de datos
//
// Este archivo es la traducción directa, entidad por entidad, de todas las
// reglas de negocio definidas durante el diseño de la plataforma: portales de
// Creador y Marca, Panel Admin, motores de Atribución / Comisiones / Pagos,
// Retos y Campañas, y Mensajería.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// AUTENTICACIÓN (compatible con Auth.js / NextAuth — login compartido que
// enruta automáticamente al portal correcto según el rol de la cuenta)
// ----------------------------------------------------------------------------

enum UserRole {
  CREATOR
  BRAND
  ADMIN
}

/// Roles internos del Panel Admin — permisos limitados por rol (Fase 2, pero
/// el modelo ya queda listo desde ahora para no rediseñar después).
enum AdminRole {
  OWNER // Propietario: acceso total
  SUPPORT // Ve y resuelve disputas/reclamos
  FINANCE // Ve panel de finanzas, cobros, pagos, reportes
  BRAND_APPROVER // Revisa y aprueba/rechaza marcas nuevas
  CREATOR_APPROVER // Gestiona creadores (suspender/reactivar cuentas)
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String? // null si el usuario solo usa login con Google
  image         String?
  role          UserRole

  // Solo aplica si role = ADMIN
  adminRole        AdminRole?
  twoFactorEnabled Boolean    @default(false)
  twoFactorSecret  String?

  creatorProfile CreatorProfile?
  brandProfile   BrandProfile?

  notifications Notification[]
  deviceTokens  DeviceToken[]

  accounts Account[]
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Modelos requeridos por el adaptador de Prisma de Auth.js (login con Google,
// y en el futuro Instagram, para creadores).
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Usado tanto para verificación de email como para recuperación de contraseña.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Token de un solo uso, de muy corta duración, para que un admin Propietario
/// pueda "entrar como" una marca o un creador y ver el portal tal cual lo ve
/// esa cuenta (soporte, pruebas) — nunca se reutiliza el mecanismo de
/// VerificationToken para esto, porque ese sí se manda por correo y no debe
/// poder usarse para iniciar sesión sin contraseña.
model ImpersonationToken {
  id              String   @id @default(cuid())
  token           String   @unique
  targetUserId    String
  createdByUserId String
  expires         DateTime
  createdAt       DateTime @default(now())
}

// ----------------------------------------------------------------------------
// VERTICALES Y CATEGORÍAS
// Estructurado en dos niveles desde el día 1 para soportar la expansión
// planeada (Uñas -> Belleza y cuidado personal -> Moda y ropa) sin tener que
// rediseñar nada — hoy solo existirá el vertical "Uñas" poblado.
// ----------------------------------------------------------------------------

model Vertical {
  id         String     @id @default(cuid())
  name       String     @unique // ej. "Uñas", "Belleza y cuidado personal", "Moda y ropa"
  slug       String     @unique
  categories Category[]

  brandProfiles    BrandProfile[]
  creatorProfiles  CreatorProfile[]
  creatorInterests CreatorInterest[]
}

model Category {
  id         String   @id @default(cuid())
  name       String // ej. "Esmaltes", "Herramientas", "Extensiones"
  slug       String
  verticalId String
  vertical   Vertical @relation(fields: [verticalId], references: [id])

  offers Offer[]

  @@unique([verticalId, slug])
}

// ----------------------------------------------------------------------------
// PERFIL DE CREADOR
// ----------------------------------------------------------------------------

enum CreatorPayoutMethod {
  BANK
  BRE_B
}

model CreatorProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName String
  bio         String?
  photoUrl    String?
  city        String?
  country     String  @default("Colombia")

  /// Nombre y apellido completo — para pagos/identidad legal, nunca se
  /// muestra en la vitrina pública (ahí solo se ve displayName, que es como
  /// el creador es conocido — ej. "Laura" en la vida real, "dani15" en
  /// redes/vitrina).
  legalName String?
  /// Cédula del titular — la piden bancos/Bre-B para validar que la cuenta
  /// realmente es de esa persona antes de dejar transferir.
  documentId String?
  /// Celular/WhatsApp — para que una marca pueda coordinar logística
  /// (envío de producto, campañas) sin tener que pedirlo por chat.
  phone String?

  /// Confirmación de Términos y Condiciones — se pone al registrarse, igual
  /// que BrandProfile.termsAcceptedAt.
  termsAcceptedAt DateTime?

  verticalId String?
  vertical   Vertical? @relation(fields: [verticalId], references: [id])

  /// Categorías de interés (multi-selección) — a diferencia de verticalId
  /// (heredado, uno solo), esto es lo que se usa en el onboarding para que
  /// el creador marque todas las que le interesen. Sirve para saber qué
  /// potencial de creadores hay en categorías a las que Marcolini todavía
  /// no se expande (ej. Mascotas, Moda) — ver CreatorInterest.
  interests CreatorInterest[]

  /// El código de identidad único del creador (ej. "LAURA30") — nace del
  /// nombre al registrarse. Sirve como sugerencia de partida al unirse a una
  /// marca, pero el código real que usa en cada tienda (CreatorOfferEnrollment.discountCode)
  /// es independiente por marca, porque cada tienda tiene sus propias reglas.
  baseCode String @unique

  /// "Modo Descubrible" (Fase 2 — Marcolini Discover): apagado por defecto.
  /// Mientras esté en false, ninguna marca puede encontrar este perfil en un
  /// directorio de búsqueda — solo aparece en "Creadores vinculados" de las
  /// marcas a las que él mismo decidió unirse.
  discoverable Boolean @default(false)

  /// El admin puede suspender una cuenta (ej. fraude detectado, código
  /// compartido/vendido) sin necesidad de eliminarla.
  suspended Boolean @default(false)

  /// Slug de su página pública "Mi Storefront" (ej. marcolini.co/@lauragomez)
  storefrontSlug String @unique

  /// Personalización de la vitrina pública — paletas y fuentes prearmadas
  /// (ver src/lib/creator-storefront-themes.ts para las opciones válidas),
  /// nunca color/fuente libres, para que siempre se vea bien combinado.
  storefrontPalette String  @default("rosa-marcolini")
  storefrontFont    String  @default("clasica")
  storefrontHeadline String?

  // Datos de pago para el desembolso — el pago en sí es manual (ver
  // payment-service.ts), esto es solo dónde debe llegar la plata.
  payoutMethod      CreatorPayoutMethod?
  breBKey           String?
  bankName          String?
  bankAccountType   String?
  bankAccountNumber String?
  paymentHolderName String?

  /// Recordatorios para terminar el onboarding (no bloqueante, así que solo
  /// son un empujón) — a los 3 y 7 días de registrarse si todavía no lo
  /// completó. Ver sendOnboardingReminders en creator-onboarding-service.ts.
  /// Null = todavía no se le mandó ese recordatorio.
  onboardingReminder1SentAt DateTime?
  onboardingReminder2SentAt DateTime?

  socialLinks           CreatorSocialLink[]
  enrollments           CreatorOfferEnrollment[]
  transactions          Transaction[]
  commissions           Commission[]
  payouts               Payout[]
  instantPayoutRequests InstantPayoutRequest[]
  challengeRewards      ChallengeReward[]
  conversations         Conversation[]
  badges                CreatorBadge[]
  challengeUrgencyPings ChallengeUrgencyPing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Insignias por logros — se otorgan solas, una vez, dentro del cron diario
/// (ver evaluateCreatorBadges en creator-badge-service.ts). El catálogo de
/// claves válidas vive en src/lib/creator-badges.ts, no acá — así se pueden
/// agregar insignias nuevas sin migración.
model CreatorBadge {
  id String @id @default(cuid())

  creatorId String
  creator   CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  badgeKey String
  earnedAt DateTime @default(now())

  @@unique([creatorId, badgeKey])
}

model CreatorSocialLink {
  id               String         @id @default(cuid())
  creatorProfileId String
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  platform        String // Instagram, TikTok, Facebook...
  handle          String
  approxFollowers Int?
}

/// Categoría de interés marcada por el creador en el onboarding —
/// multi-selección, a diferencia de CreatorProfile.verticalId (single,
/// heredado). No implica nada operativo todavía (Marcolini solo opera en
/// Uñas hoy) — es información para saber hacia dónde expandir.
model CreatorInterest {
  id String @id @default(cuid())

  creatorProfileId String
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  verticalId String
  vertical   Vertical @relation(fields: [verticalId], references: [id])

  @@unique([creatorProfileId, verticalId])
}

// ----------------------------------------------------------------------------
// PERFIL DE MARCA
// ----------------------------------------------------------------------------

enum BrandStatus {
  PENDING // esperando aprobación del admin
  APPROVED
  REJECTED
  PAUSED
}

/// Le permite al admin forzar si una marca aparece o no en el marketplace de
/// creadores, sin importar si de verdad completó los 4 pasos de onboarding
/// (perfil, tienda conectada, cómo-te-cobramos) — pensado para que Juan pueda
/// probar visualmente el flujo del creador con marcas de prueba a medio
/// llenar, sin tener que completarles todo el onboarding real primero.
enum MarketplaceVisibilityOverride {
  AUTO // comportamiento normal: visible solo si cumple todos los requisitos reales
  FORCE_VISIBLE
  FORCE_HIDDEN
}

enum StoreType {
  SHOPIFY
  WOOCOMMERCE
  OTHER // método de código con reporte manual, sin webhook automático
}

enum StoreConnectionStatus {
  NOT_CONNECTED
  CONNECTED
  ERROR
}

/// Modalidad de vinculación de creadores a una oferta (se explica con texto
/// claro en el Portal Marca al elegir).
enum JoinMode {
  OPEN // "Cualquier creador puede unirse automáticamente"
  APPROVAL // "Tú revisas el perfil de cada creador antes de aceptarlo"
}

model BrandProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName String
  legalName   String? // razón social
  taxId       String? // NIT
  logoUrl     String?
  description String?
  city        String?
  country     String  @default("Colombia")

  /// Perfil más sólido — para que se vea profesional y sirva también para
  /// lo tributario/facturación (ver BrandInvoice).
  websiteUrl        String?
  phone             String?
  fiscalAddress     String?
  taxRegime         String? // ej. "Responsable de IVA" / "No responsable"
  legalRepName      String? // representante legal
  legalRepId        String? // cédula del representante legal
  instagramHandle   String?
  tiktokHandle      String?
  rutDocumentUrl    String? // PDF/imagen del RUT
  camaraComercioUrl String? // PDF/imagen de Cámara de Comercio

  verticalId String?
  vertical   Vertical? @relation(fields: [verticalId], references: [id])

  status       BrandStatus @default(PENDING)
  approvedAt   DateTime?
  approvedById String? // referencia al User admin que aprobó

  marketplaceVisibilityOverride MarketplaceVisibilityOverride @default(AUTO)

  termsAcceptedAt DateTime?

  /// Confirmación del paso "Cómo te cobramos" del onboarding — la marca vio
  /// y entendió el ciclo de corte mensual, transferencia y bloqueo por
  /// impago antes de salir en vivo.
  billingAcknowledgedAt DateTime?

  storeType             StoreType             @default(OTHER)
  storeUrl              String?
  storeConnectionStatus StoreConnectionStatus @default(NOT_CONNECTED)
  storeLastSyncedAt     DateTime?
  // Credenciales de integración (en producción: cifradas / en un vault, no en texto plano)
  shopifyAccessToken    String?
  wooConsumerKey        String?
  wooConsumerSecret     String?
  /// Secreto único para verificar la firma de los webhooks entrantes (tanto
  /// Shopify como WooCommerce) — se genera al conectar la tienda.
  webhookSecret         String?

  /// Tarifa de plataforma para ESTA marca. Si es null, aplica el valor por
  /// defecto de PlatformConfig (5%) — el admin puede sobrescribirla por
  /// negociación, y la marca lo ve reflejado automáticamente en su portal.
  platformFeePercentOverride Decimal? @db.Decimal(5, 2)

  offers       Offer[]
  charges      BrandCharge[]
  invoices     BrandInvoice[]
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// OFERTA (el programa de afiliación de una marca)
// ----------------------------------------------------------------------------

enum OfferStatus {
  ACTIVE
  PAUSED
}

model Offer {
  id      String       @id @default(cuid())
  brandId String
  brand   BrandProfile @relation(fields: [brandId], references: [id], onDelete: Cascade)

  name        String
  description String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  status OfferStatus @default(ACTIVE)

  /// % que gana el creador — el 100% de este valor es del creador (modelo
  /// Awin: la marca lo paga aparte de la tarifa de Marcolini, nunca se
  /// descuenta del creador).
  defaultCommissionPercent Decimal @db.Decimal(5, 2)

  /// % de descuento que ve el comprador final al usar el código — campo
  /// independiente de la comisión, configurable también por creador.
  defaultDiscountPercent Decimal @db.Decimal(5, 2)

  joinMode JoinMode @default(OPEN)

  startDate DateTime?
  endDate   DateTime?

  enrollments  CreatorOfferEnrollment[]
  challenges   Challenge[]
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// VINCULACIÓN CREADOR <-> OFERTA ("Creadores vinculados")
// ----------------------------------------------------------------------------

enum EnrollmentStatus {
  PENDING_APPROVAL // solo aplica si la oferta es JoinMode.APPROVAL
  ACTIVE
  REJECTED
  REMOVED
}

model CreatorOfferEnrollment {
  id String @id @default(cuid())

  creatorId String
  creator   CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  offerId String
  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)

  status EnrollmentStatus @default(ACTIVE)

  /// Comisión/descuento negociados específicamente para este creador en esta
  /// oferta — si son null, aplica el valor general de la Offer.
  commissionPercentOverride Decimal? @db.Decimal(5, 2)
  discountPercentOverride   Decimal? @db.Decimal(5, 2)

  /// El código real creado en la tienda de la marca (normalmente idéntico al
  /// baseCode del creador — solo difiere si hubo colisión con un código ya
  /// existente en esa tienda puntual).
  discountCode String

  // Referencia al objeto creado vía API en la tienda de la marca
  shopifyPriceRuleId String?
  wooCouponId        String?

  /// Control del creador sobre su propia vitrina — qué marcas se muestran
  /// ahí y en qué orden (menor primero). No afecta nada operativo, solo la
  /// página pública /c/[slug].
  storefrontVisible Boolean @default(true)
  storefrontOrder   Int     @default(0)

  transactions  Transaction[]
  conversations Conversation[]
  shipments     ProductShipment[]

  joinedAt DateTime @default(now())

  @@unique([offerId, creatorId])
}

// ----------------------------------------------------------------------------
// RETOS Y CAMPAÑAS
// ----------------------------------------------------------------------------

enum ChallengeType {
  GOAL_BONUS // Bono por meta de ventas
  TEMP_COMMISSION_BOOST // Comisión temporal elevada
  LEADERBOARD // Leaderboard con premio al Top N
  WELCOME_BONUS // Bono de bienvenida (primeros N cupos)
  CONTENT_CHALLENGE // Reto de contenido (verificación manual)
}

enum ChallengeStatus {
  ACTIVE
  ENDED
}

model Challenge {
  id      String @id @default(cuid())
  offerId String
  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)

  type   ChallengeType
  name   String
  status ChallengeStatus @default(ACTIVE)

  startDate DateTime
  endDate   DateTime

  /// Configuración flexible según el tipo de reto:
  /// GOAL_BONUS            -> { goalAmount, bonusAmount }
  /// TEMP_COMMISSION_BOOST  -> { newCommissionPercent }
  /// LEADERBOARD            -> { winnersCount, prizes: [amount, ...] }
  /// WELCOME_BONUS          -> { slotsCount, bonusPerSlot }
  /// CONTENT_CHALLENGE      -> { instructions, bonusAmount }
  config Json

  rewards       ChallengeReward[]
  urgencyPings  ChallengeUrgencyPing[]

  createdAt DateTime @default(now())
}

/// Registro de qué recordatorio de urgencia ("quedan 3 días" / "queda 1
/// día") ya se le mandó a qué creador para qué reto — evita mandarlo dos
/// veces si el cron corre más de una vez el mismo día. Ver
/// sendChallengeUrgencyReminders en challenge-service.ts.
model ChallengeUrgencyPing {
  id String @id @default(cuid())

  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  creatorId String
  creator   CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  window String // "3d" | "1d"

  sentAt DateTime @default(now())

  @@unique([challengeId, creatorId, window])
}

enum ChallengeRewardStatus {
  PENDING_REVIEW // solo CONTENT_CHALLENGE: la marca todavía no revisó la evidencia
  PENDING // ganado, en la misma ventana de espera por reembolsos que una Commission
  APPROVED // lista para el próximo pago (día 15 o adelanto)
  PAID
  REJECTED // la marca no aprobó la evidencia (solo CONTENT_CHALLENGE)
}

/// Un premio ganado por un creador en un reto — se paga por el mismo Motor
/// de Pagos que las comisiones normales (mismo hold de reembolsos, mismo
/// Payout del día 15, mismo adelanto instantáneo), pero es dinero aparte de
/// cualquier venta puntual.
model ChallengeReward {
  id          String    @id @default(cuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  creatorId String
  creator   CreatorProfile @relation(fields: [creatorId], references: [id])

  amount Decimal               @db.Decimal(12, 2)
  status ChallengeRewardStatus @default(PENDING)

  /// Solo CONTENT_CHALLENGE: lo que el creador mandó como evidencia.
  submissionUrl  String?
  submissionNote String?
  reviewedAt     DateTime?
  reviewedById   String? // userId de la marca que aprobó/rechazó

  holdUntil  DateTime?
  approvedAt DateTime?

  /// A qué corte del día 1 quedó asociado, solo para el desglose del aviso
  /// de cobro de esa marca — el pago al creador ya NO depende de que ese
  /// corte esté verificado (ver payment-service.ts): Marcolini le paga en
  /// su fecha normal así la marca esté atrasada o bloqueada, nunca al
  /// revés.
  brandChargeId String?
  brandCharge   BrandCharge? @relation(fields: [brandChargeId], references: [id])

  payoutId String?
  payout   Payout? @relation(fields: [payoutId], references: [id])

  instantPayoutRequestId String?
  instantPayoutRequest   InstantPayoutRequest? @relation(fields: [instantPayoutRequestId], references: [id])

  createdAt DateTime @default(now())

  @@unique([challengeId, creatorId])
}

// ----------------------------------------------------------------------------
// MOTOR DE ATRIBUCIÓN — Transacciones detectadas vía Shopify/WooCommerce
// ----------------------------------------------------------------------------

enum TransactionSource {
  SHOPIFY
  WOOCOMMERCE
  MANUAL // reporte manual para marcas sin integración (StoreType.OTHER)
}

enum TransactionStatus {
  COMPLETED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Transaction {
  id String @id @default(cuid())

  brandId String
  brand   BrandProfile @relation(fields: [brandId], references: [id])

  offerId String
  offer   Offer  @relation(fields: [offerId], references: [id])

  creatorId String
  creator   CreatorProfile @relation(fields: [creatorId], references: [id])

  enrollmentId String
  enrollment   CreatorOfferEnrollment @relation(fields: [enrollmentId], references: [id])

  source          TransactionSource
  externalOrderId String // id de la orden en Shopify/WooCommerce — para MANUAL, se genera solo

  grossAmount    Decimal @db.Decimal(12, 2) // precio de lista
  discountAmount Decimal @db.Decimal(12, 2) // lo que no pagó el cliente
  netAmount      Decimal @db.Decimal(12, 2) // lo que realmente pagó el cliente (base de la comisión)

  /// Solo se usa con source MANUAL — la referencia que la marca escribió al
  /// reportar la venta a mano (ej. "Pedido de Instagram #4521"), para poder
  /// auditarla después. Null en ventas de Shopify/WooCommerce.
  note String?

  status TransactionStatus @default(COMPLETED)

  occurredAt DateTime
  refundedAt DateTime?

  commission Commission?

  createdAt DateTime @default(now())

  /// El mismo pedido nunca puede convertirse en dos Transactions — protege
  /// contra reintentos de webhook (Shopify/WooCommerce reenvían si no
  /// reciben 200 a tiempo).
  @@unique([brandId, source, externalOrderId])
}

// ----------------------------------------------------------------------------
// MOTOR DE COMISIONES
// ----------------------------------------------------------------------------

enum CommissionStatus {
  PENDING // dentro de la ventana de 15 días de espera por reembolsos
  APPROVED // ya se puede incluir en el próximo pago del día 15
  PAID
  REVERSED // hubo reembolso/contracargo, se anula
}

model Commission {
  id String @id @default(cuid())

  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  /// 100% para el creador — la marca lo factura/paga completo, sin descuento
  /// de la tarifa de plataforma (modelo Awin).
  creatorCommissionAmount Decimal @db.Decimal(12, 2)

  /// Tarifa de Marcolini, cobrada aparte a la marca.
  platformFeeAmount    Decimal @db.Decimal(12, 2)
  platformFeeVatAmount Decimal @db.Decimal(12, 2) // IVA sobre la tarifa (pendiente de confirmación contable)

  status CommissionStatus @default(PENDING)

  /// Fecha en la que se levanta la espera de 15 días por reembolsos.
  holdUntil DateTime

  approvedAt DateTime?
  reversedAt DateTime?

  payoutId String?
  payout   Payout? @relation(fields: [payoutId], references: [id])

  instantPayoutRequestId String?
  instantPayoutRequest   InstantPayoutRequest? @relation(fields: [instantPayoutRequestId], references: [id])

  /// A qué corte del día 1 quedó asociada, solo para el desglose del aviso
  /// de cobro de esa marca — el pago al creador ya NO depende de que ese
  /// corte esté verificado (ver payment-service.ts): Marcolini le paga en
  /// su fecha normal así la marca esté atrasada o bloqueada, nunca al
  /// revés.
  brandChargeId String?
  brandCharge   BrandCharge? @relation(fields: [brandChargeId], references: [id])

  createdAt        DateTime        @default(now())
  creatorProfile   CreatorProfile? @relation(fields: [creatorProfileId], references: [id])
  creatorProfileId String?
}

// ----------------------------------------------------------------------------
// MOTOR DE PAGOS (ePayco — Pagos Divididos)
// ----------------------------------------------------------------------------

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

/// Desembolso del día 15 a un creador — agrupa todas sus comisiones
/// aprobadas del período.
model Payout {
  id String @id @default(cuid())

  creatorId String
  creator   CreatorProfile @relation(fields: [creatorId], references: [id])

  periodStart DateTime
  periodEnd   DateTime

  totalAmount Decimal      @db.Decimal(12, 2)
  status      PayoutStatus @default(PENDING)

  epaycoTransactionRef String?
  paidAt               DateTime?

  commissions      Commission[]
  challengeRewards ChallengeReward[]

  createdAt DateTime @default(now())
}

enum BrandChargeStatus {
  PENDING // corte generado, esperando comprobante — el contador de dueAt está corriendo
  PROOF_SUBMITTED // la marca subió comprobante, esperando verificación del admin
  PAID // el admin verificó el comprobante
  OVERDUE // pasó dueAt sin comprobante verificado — la marca queda bloqueada (ver isBrandPaymentLocked)
}

/// Corte del día 1: cubre comisiones + tarifa de plataforma + IVA del
/// período. La marca paga por transferencia directa (QR/Bre-B, ver
/// PlatformConfig.paymentInstructions) y sube su comprobante en la
/// plataforma — no hay cobro automático a tarjeta ni procesador de pagos de
/// por medio. Si no se verifica el pago antes de `dueAt`, la marca queda
/// bloqueada (ver isBrandPaymentLocked en payment-service.ts) hasta
/// regularizar. A los creadores se les sigue pagando en su fecha normal sin
/// importar el estado de este corte — Marcolini asume ese riesgo, nunca el
/// creador.
model BrandCharge {
  id String @id @default(cuid())

  brandId String
  brand   BrandProfile @relation(fields: [brandId], references: [id])

  periodStart DateTime
  periodEnd   DateTime

  totalAmount Decimal           @db.Decimal(12, 2)
  status      BrandChargeStatus @default(PENDING)

  /// Fecha límite fija (createdAt + PlatformConfig.paymentGraceHours) para
  /// subir y que se verifique el comprobante — no se corre aunque la marca
  /// entre a mirar el aviso varios días después.
  dueAt DateTime

  /// El aviso de cobro que se genera al crear el corte (monto, desglose,
  /// instrucciones de pago, fecha límite) — se muestra en el dashboard y se
  /// manda por correo.
  pdfUrl String?

  proofUrl            String?
  proofSubmittedAt    DateTime?
  proofRejectedAt     DateTime?
  proofRejectedReason String?

  /// Marcan si ya se mandó el recordatorio de "te quedan 48h/24h" — para no
  /// reenviarlo cada vez que corre el cron mientras el corte siga abierto.
  reminder48SentAt DateTime?
  reminder24SentAt DateTime?

  paidAt           DateTime?
  verifiedByUserId String? // userId del admin que verificó el comprobante

  commissions      Commission[]
  challengeRewards ChallengeReward[]

  createdAt DateTime @default(now())
}

/// La factura electrónica de verdad se genera por fuera (proveedor de
/// facturación electrónica) — Marcolini le manda qué cobrar, y de vuelta
/// llega un PDF. Este modelo es solo el registro de ese PDF ya generado,
/// para que la marca lo pueda ver y descargar desde su portal.
model BrandInvoice {
  id String @id @default(cuid())

  brandId String
  brand   BrandProfile @relation(fields: [brandId], references: [id], onDelete: Cascade)

  period String // ej. "2026-08" (mes que factura)
  amount Decimal @db.Decimal(12, 2)
  pdfUrl String
  note   String?

  uploadedByUserId String

  createdAt DateTime @default(now())
}

enum InstantPayoutStatus {
  REQUESTED
  PROCESSED
  FAILED
}

/// Cobro anticipado: el creador adelanta una comisión ya aprobada antes del
/// día 15, pagando un fee del 5% — ese 5% es ingreso de Marcolini.
model InstantPayoutRequest {
  id String @id @default(cuid())

  creatorId String
  creator   CreatorProfile @relation(fields: [creatorId], references: [id])

  amountRequested Decimal @db.Decimal(12, 2)
  feeAmount       Decimal @db.Decimal(12, 2) // 5% — ingreso de Marcolini

  status      InstantPayoutStatus @default(REQUESTED)
  processedAt DateTime?

  commissions      Commission[]
  challengeRewards ChallengeReward[]

  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// CONFIGURACIÓN GLOBAL DE LA PLATAFORMA (Panel Admin)
// ----------------------------------------------------------------------------

/// Tabla de una sola fila — los números que el admin puede ajustar sin tocar
/// código: tarifa por defecto, días de cobro/pago, ventana de reembolsos.
model PlatformConfig {
  id                        String  @id @default("singleton")
  defaultPlatformFeePercent Decimal @default(5.0) @db.Decimal(5, 2)
  vatPercent                Decimal @default(19.0) @db.Decimal(5, 2)
  chargeDayOfMonth          Int     @default(1)
  payoutDayOfMonth          Int     @default(15)
  refundHoldDays            Int     @default(15)
  instantPayoutFeePercent   Decimal @default(5.0) @db.Decimal(5, 2)

  /// Cómo le pagan las marcas a Marcolini — texto libre (cuenta bancaria,
  /// Nequi, llave Bre-B, lo que aplique) más un QR opcional, mostrados en
  /// cada aviso de cobro. Editable desde el Panel Admin, sin depender de un
  /// deploy.
  paymentInstructions String?
  paymentQrImageUrl   String?

  /// Horas desde que se genera el corte hasta que, sin comprobante
  /// verificado, la marca queda bloqueada.
  paymentGraceHours Int @default(72)

  updatedAt DateTime @updatedAt
}

/// Costos operativos que el admin ingresa manualmente cada mes (hosting,
/// herramientas, equipo...) — el ingreso (tarifa de plataforma) ya se
/// calcula solo; el costo no puede saberlo el sistema por su cuenta, así
/// que alimenta el Panel de Rentabilidad del Dashboard Global.
model MonthlyOperatingCost {
  id     String   @id @default(cuid())
  month  DateTime // se guarda como el día 1 del mes correspondiente
  amount Decimal  @db.Decimal(12, 2)
  note   String?

  createdAt DateTime @default(now())

  @@unique([month])
}

/// Contenido legal editable desde el Panel Admin (ej. Términos y
/// Condiciones) sin depender de un desarrollador para cambiar una palabra.
model LegalContent {
  id    String @id @default(cuid())
  key   String @unique // ej. "terms"
  title String
  body  String @db.Text

  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// NOTIFICACIONES
// ----------------------------------------------------------------------------

/// Token de dispositivo para notificaciones push (APNs / FCM). No se usa
/// todavía — existe desde ahora para que, cuando se construya la app móvil
/// (iOS/Android), no haga falta una migración nueva solo para esto.
model DeviceToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  platform String // "ios" | "android"
  token    String @unique

  createdAt DateTime @default(now())
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    String // ej. "brand_approved", "sale_generated", "payout_processed", "fee_changed"
  message String
  read    Boolean @default(false)

  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// COMUNICADOS (broadcast del admin a todas las marcas o a todos los creadores)
// ----------------------------------------------------------------------------

enum BroadcastAudience {
  BRANDS
  CREATORS
}

enum BroadcastChannel {
  EMAIL
  NOTIFICATION // vía Notification — el mismo canal que se vuelve push apenas exista la app móvil
}

model Broadcast {
  id String @id @default(cuid())

  audience BroadcastAudience
  channel  BroadcastChannel

  subject String
  body    String @db.Text

  recipientCount Int

  sentByUserId String

  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// COLA DE ANTIFRAUDE (Fase 1 — reglas básicas del Panel Admin)
// ----------------------------------------------------------------------------

enum FraudFlagStatus {
  PENDING_REVIEW
  CLEARED
  CONFIRMED_FRAUD
}

model FraudFlag {
  id            String @id @default(cuid())
  transactionId String
  reason        String // ej. "email comprador = email creador", "pico anormal de órdenes con este código"

  status FraudFlagStatus @default(PENDING_REVIEW)

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
}

// ----------------------------------------------------------------------------
// MENSAJERÍA (solo entre una marca y sus creadores YA vinculados — nunca un
// directorio abierto de búsqueda de creadores para las marcas)
// ----------------------------------------------------------------------------

model Conversation {
  id String @id @default(cuid())

  enrollmentId String
  enrollment   CreatorOfferEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  creatorId String
  creator   CreatorProfile @relation(fields: [creatorId], references: [id])

  messages Message[]

  createdAt DateTime @default(now())

  @@unique([enrollmentId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderUserId String
  body         String

  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// ENVÍO DE PRODUCTO (dentro de la misma relación marca↔creador vinculado —
// el creador pide, o la marca ofrece, un producto físico como parte de la
// colaboración)
// ----------------------------------------------------------------------------

enum ShipmentStatus {
  REQUESTED // el creador lo pidió, la marca todavía no lo despacha
  SENT
  DELIVERED
}

enum ShipmentRequestedBy {
  CREATOR
  BRAND
}

model ProductShipment {
  id String @id @default(cuid())

  enrollmentId String
  enrollment   CreatorOfferEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  requestedBy ShipmentRequestedBy
  description String

  /// Dirección de envío — se captura en el momento (no se guarda un perfil
  /// de direcciones aparte), porque puede cambiar de un envío a otro.
  shippingAddress String

  status ShipmentStatus @default(REQUESTED)

  carrier        String?
  trackingNumber String?

  sentAt      DateTime?
  deliveredAt DateTime?

  createdAt DateTime @default(now())
}
